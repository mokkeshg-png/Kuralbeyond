# ──────────────────────────────────────────────────
# TamilPalam — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env!
# ──────────────────────────────────────────────────

# ── Supabase (frontend) ────────────────────────────
# These are the PUBLIC credentials from your Supabase project → Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Set to "true" to force the mock/localStorage adapter (useful for offline demos)
VITE_USE_MOCK_STORAGE=false

# ── Supabase (server-side — Edge Functions only) ──
# NEVER put this in the frontend or client bundle!
# Set via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# ── Sarvam AI (Edge Functions only) ───────────────
# Voice API key from https://dashboard.sarvam.ai
# Set via: supabase secrets set SARVAM_API_KEY=<your-key>
# SARVAM_API_KEY=your-sarvam-api-subscription-key

# ── App Configuration ─────────────────────────────
# Frontend origin for CORS in Edge Functions
# ALLOWED_ORIGIN=http://localhost:5173
